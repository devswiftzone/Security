@Tutorial(time: 45) {
    @Intro(title: "Setting Up Role-Based Access Control") {
        Add roles, permissions, and authorization policies to protect your Vapor application resources.

        @Image(source: rbac-diagram.svg, alt: "RBAC diagram showing the relationship between users, roles, and permissions")
    }

    @Section(title: "Create Roles and Permissions") {
        @Steps {
            @Step {
                Create the roles your application needs. Each role is a named collection of permissions.
                @Code(name: "seed.swift", file: "seed-1.swift")
            }
            @Step {
                Create fine-grained permissions. These are the individual access rights you will attach to roles.
                @Code(name: "seed.swift", file: "seed-2.swift")
            }
            @Step {
                Attach permissions to roles. The admin role gets everything; editor and viewer get progressively fewer rights.
                @Code(name: "seed.swift", file: "seed-3.swift")
            }
            @Step {
                Assign a role to a user. From now on, that user inherits all permissions of the role.
                @Code(name: "seed.swift", file: "seed-roles.swift")
            }
        }
    }

    @Section(title: "Protect Routes with Middleware") {
        @Steps {
            @Step {
                Use ``PermissionMiddleware`` to gate a route group on a specific permission. Requests without that permission receive a 403.
                @Code(name: "routes.swift", file: "rbac-routes-1.swift")
            }
            @Step {
                Use ``RoleMiddleware`` to restrict an entire route group to users with a specific role.
                @Code(name: "routes.swift", file: "rbac-routes-2.swift")
            }
            @Step {
                Use `req.security.require(permission:)` and `req.security.can(_:)` for inline checks inside a handler.
                @Code(name: "routes.swift", file: "rbac-routes.swift")
            }
        }
    }

    @Section(title: "Create a Custom Authorization Policy") {
        @Steps {
            @Step {
                Implement ``AuthorizationPolicy`` to express complex, reusable authorization logic — here, checking whether the authenticated user owns a post.
                @Code(name: "policies.swift", file: "custom-policy.swift")
            }
            @Step {
                Apply the policy in a route handler with `req.security.require(_:)`. If `evaluate` returns false, the request is rejected with a 403.
                @Code(name: "routes.swift", file: "custom-policy-route.swift")
            }
        }
    }

    @Section(title: "Compose Policies") {
        @Steps {
            @Step {
                Combine policies with `&&` and `||`. SecurityKit evaluates them lazily — `||` short-circuits on the first grant, `&&` short-circuits on the first denial.
                @Code(name: "routes.swift", file: "compose-policies.swift")
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            What is the relationship between a Role and a Permission?

            @Choice(isCorrect: true) {
                A role is a named collection of permissions; a permission is a fine-grained access right.

                @Justification(reaction: "Correct!") {
                    Grouping permissions into roles makes it easy to grant and revoke many rights at once.
                }
            }
            @Choice(isCorrect: false) {
                They are the same concept with different names.

                @Justification(reaction: "Not quite.") {
                    Roles and permissions serve different purposes: roles group permissions, permissions define individual actions.
                }
            }
            @Choice(isCorrect: false) {
                A permission is a collection of roles.

                @Justification(reaction: "That's backwards.") {
                    Roles contain permissions, not the other way around.
                }
            }
        }

        @MultipleChoice {
            Which protocol do you implement to write custom authorization logic?

            @Choice(isCorrect: true) {
                ``AuthorizationPolicy``

                @Justification(reaction: "Correct!") {
                    Implement `evaluate(_:) async throws -> Bool` to express any authorization rule you need.
                }
            }
            @Choice(isCorrect: false) {
                ``AuthServiceProtocol``

                @Justification(reaction: "Not quite.") {
                    `AuthServiceProtocol` handles authentication flows (login, register), not authorization decisions.
                }
            }
            @Choice(isCorrect: false) {
                ``SecurityUser``

                @Justification(reaction: "Not quite.") {
                    `SecurityUser` defines the user model contract, not authorization logic.
                }
            }
        }
    }
}
