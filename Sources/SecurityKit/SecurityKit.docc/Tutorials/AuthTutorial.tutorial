@Tutorial(time: 30) {
    @Intro(title: "Adding Authentication to Your Vapor App") {
        Add user registration, login, and token management to your Vapor application using SecurityKit.

        @Image(source: auth-flow.svg, alt: "Authentication flow diagram")
    }

    @Section(title: "Configure the Package") {
        @Steps {
            @Step {
                Open your `Package.swift` and add the SecurityKit dependency.
                @Code(name: "Package.swift", file: "add-dependency.swift")
            }
            @Step {
                Create or update `configure.swift`. Call `app.security.useFluent()` to register the password hasher, token generator, and all migrations.
                @Code(name: "configure.swift", file: "configure-security.swift")
            }
        }
    }

    @Section(title: "Create Auth Routes") {
        @Steps {
            @Step {
                Add a registration endpoint. It accepts a ``RegisterRequest`` and returns a ``TokenResponse`` with an access and refresh token.
                @Code(name: "routes.swift", file: "auth-routes-1.swift")
            }
            @Step {
                Add a login endpoint. It accepts a ``LoginRequest``, verifies credentials, and returns tokens.
                @Code(name: "routes.swift", file: "auth-routes-2.swift")
            }
            @Step {
                Group the remaining endpoints behind ``BearerTokenMiddleware``. Only requests with a valid access token can reach these routes.
                @Code(name: "routes.swift", file: "auth-routes.swift")
            }
        }
    }

    @Section(title: "Verify It Works") {
        @Steps {
            @Step {
                Register a new user with curl. The response contains your access and refresh tokens.
                @Code(name: "Terminal", file: "curl-register.sh")
            }
            @Step {
                Log in with the same credentials to receive a fresh token pair.
                @Code(name: "Terminal", file: "curl-login.sh")
            }
            @Step {
                Use the access token in the `Authorization` header to reach a protected route.
                @Code(name: "Terminal", file: "curl-protected.sh")
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            Which middleware validates the Bearer token and protects a route group?

            @Choice(isCorrect: true) {
                `BearerTokenMiddleware`

                @Justification(reaction: "Correct!") {
                    `BearerTokenMiddleware` reads the `Authorization: Bearer <token>` header and authenticates the request.
                }
            }
            @Choice(isCorrect: false) {
                `PermissionMiddleware`

                @Justification(reaction: "Not quite.") {
                    `PermissionMiddleware` checks for a specific permission on an already-authenticated request.
                }
            }
            @Choice(isCorrect: false) {
                `RoleMiddleware`

                @Justification(reaction: "Not quite.") {
                    `RoleMiddleware` checks for a specific role on an already-authenticated request.
                }
            }
        }

        @MultipleChoice {
            What does ``AuthServiceProtocol/register(_:on:)`` return on success?

            @Choice(isCorrect: true) {
                `TokenResponse`

                @Justification(reaction: "Correct!") {
                    `register` issues tokens immediately so the user is logged in right after signing up.
                }
            }
            @Choice(isCorrect: false) {
                `User`

                @Justification(reaction: "Not quite.") {
                    The user record is created internally, but what is returned to the client is the token pair.
                }
            }
            @Choice(isCorrect: false) {
                `HTTPStatus`

                @Justification(reaction: "Not quite.") {
                    A status code alone is not returned; the caller needs the tokens to make authenticated requests.
                }
            }
        }
    }
}
